# ============================================================
# .env.docker — Docker-specific environment values
# Copy this file and fill in secrets before deploying.
# This file is committed as a template (no real secrets here).
# ============================================================

APP_NAME="PromptEdit"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:Iojvng4yAhGMWvvUfU+p2EqR1vZ+Yd2B9ZaGZjLJZXo=
APP_URL=http://localhost:8000

# ── Database ─────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=promptedit
DB_USERNAME=promptedit
DB_PASSWORD=secret

# ── Redis ────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Cache / Session / Queue ───────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ── Mail ─────────────────────────────────────────────────────
MAIL_MAILER=log

# ── Pixelforge ───────────────────────────────────────────────
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_API_KEY=pf_ArsOLNvJJQ7ANqPWOMJ2FsGn3hzx5m34SxG2zxbla995c0c6
PIXELFORGE_WEBHOOK_SECRET=
PROMPTEDIT_MARKUP_PERCENT=25.0

# ── Vite (not needed in production image; assets are pre-built)
VITE_APP_NAME="${APP_NAME}"
