# ============================================================
# .dockerignore — exclude files from the Docker build context
# ============================================================

# Git
.git
.gitignore
.gitattributes

# Dependencies
vendor/
node_modules/
npm-debug.log*

# Tests
tests/
phpunit.xml
phpunit.xml.dist
.phpunit.cache/

# Laravel dev artifacts
storage/logs/*.log
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
bootstrap/cache/*.php
!bootstrap/cache/.gitignore

# IDE / OS
.idea/
.vscode/
*.DS_Store
Thumbs.db

# Docker compose files
docker-compose*.yml

# CI
.github/
